{
    "name": "pollora/media",
    "description": "WordPress media on any Flysystem disk: uploads, public URLs, private files, image sizes and thumbnails, behind two settings. Runs with or without Laravel.",
    "type": "library",
    "keywords": [
        "flysystem",
        "media",
        "pollora",
        "s3",
        "uploads",
        "wordpress"
    ],
    "homepage": "https://pollora.dev/",
    "license": "MIT",
    "authors": [
        {
            "name": "Amphibee",
            "email": "contact@amphibee.fr"
        }
    ],
    "support": {
        "issues": "https://github.com/Pollora/media/issues",
        "source": "https://github.com/Pollora/media"
    },
    "require": {
        "php": "^8.3",
        "league/flysystem": "^3.0",
        "pollora/hook": "^2.0.1",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "antecedent/patchwork": "^2.2",
        "brain/monkey": "^2.7",
        "laravel/pint": "^1.22.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.8.2",
        "php-stubs/wp-cli-stubs": "dev-master",
        "phpstan/phpstan": "^2.1.16",
        "pollora/harness": "^0.1.3",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Pollora\\Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pollora\\Media\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@phpstan",
            "@lint:check"
        ],
        "test:unit": "pest",
        "test:coverage": "pest --coverage",
        "phpstan": "phpstan analyse",
        "phpstan:ci": "phpstan analyse --no-progress",
        "lint": "pint",
        "lint:check": "pint --test",
        "qa": "@php vendor/bin/pollora-qa check",
        "qa:fast": "@php vendor/bin/pollora-qa check --fast"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "league/flysystem-aws-s3-v3": "For S3 and S3-compatible storage (R2, Scaleway, MinIO, OVH)"
    }
}
